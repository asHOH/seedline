<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SameSeed</AssemblyName>
    <Version>0.6.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Hashing" HintPath="$(GameManagedDir)/System.IO.Hashing.dll" Private="false" />
    <None Include="SameSeed.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Localization/*.json" />
    <InternalsVisibleTo Include="SameSeed.Checks" />
    <InternalsVisibleTo Include="SameSeed.Tests" />
  </ItemGroup>
</Project>
